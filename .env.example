# GCP GKE Jenkins Infrastructure - Environment Variables
# Copy this file to .env and configure the values
# Usage: source .env

# =============================================================================
# GCP Project Configuration
# =============================================================================

# GCP Project ID (required)
export GCP_PROJECT_ID="speedy-insight-483010-m3"

# GCP Region for resources
export GCP_REGION="us-central1"

# GCP Zone for zonal resources (GKE cluster, Jenkins VM)
export GCP_ZONE="us-central1-a"

# =============================================================================
# GKE Cluster Configuration
# =============================================================================

# GKE Cluster name
export GKE_CLUSTER_NAME="autopilot-cluster-1"

# GKE Cluster version (leave empty for latest stable)
export GKE_CLUSTER_VERSION=""

# GKE Node pool configuration
export GKE_NODE_POOL_NAME="default-pool"
export GKE_NODE_COUNT="2"
export GKE_MIN_NODE_COUNT="1"
export GKE_MAX_NODE_COUNT="5"
export GKE_NODE_MACHINE_TYPE="e2-medium"
export GKE_NODE_DISK_SIZE_GB="50"
export GKE_NODE_DISK_TYPE="pd-standard"

# Enable preemptible nodes for cost savings (true/false)
export GKE_PREEMPTIBLE_NODES="true"

# =============================================================================
# Jenkins VM Configuration
# =============================================================================

# Jenkins VM name
export JENKINS_VM_NAME="jenkins-server"

# Jenkins VM machine type
export JENKINS_MACHINE_TYPE="e2-medium"

# Jenkins VM disk size in GB
export JENKINS_DISK_SIZE_GB="50"

# Jenkins VM disk type (pd-standard, pd-ssd, pd-balanced)
export JENKINS_DISK_TYPE="pd-standard"

# Enable preemptible VM for cost savings (true/false)
# WARNING: Preemptible VMs can be terminated at any time
export JENKINS_PREEMPTIBLE="false"

# Jenkins HTTP port
export JENKINS_HTTP_PORT="8080"

# Jenkins JNLP port (for agents)
export JENKINS_JNLP_PORT="50000"

# =============================================================================
# Networking Configuration
# =============================================================================

# VPC Network name
export VPC_NETWORK_NAME="gke-jenkins-vpc"

# Subnet name
export SUBNET_NAME="gke-jenkins-subnet"

# Subnet CIDR range
export SUBNET_CIDR="10.0.0.0/24"

# GKE Pods secondary range
export GKE_PODS_CIDR_NAME="gke-pods"
export GKE_PODS_CIDR="10.1.0.0/16"

# GKE Services secondary range
export GKE_SERVICES_CIDR_NAME="gke-services"
export GKE_SERVICES_CIDR="10.2.0.0/20"

# =============================================================================
# Service Account Configuration
# =============================================================================

# Service account name for GKE and Jenkins
export SERVICE_ACCOUNT_NAME="gke-jenkins-sa"

# Service account key path (on Jenkins VM)
export SERVICE_ACCOUNT_KEY_PATH="/var/lib/jenkins/keys/speedy-insight-483010-m3-e631e1327727.json"

# Local path for service account key (during provisioning)
export LOCAL_SA_KEY_PATH="./keys/service-account-key.json"

# =============================================================================
# Repository Configuration
# =============================================================================

# Source repository URL
export SOURCE_REPO_URL="https://github.com/kranthimj23/zdt-manager-src"

# Source repository branch
export SOURCE_REPO_BRANCH="zdt-application"

# =============================================================================
# Terraform Configuration
# =============================================================================

# Terraform state bucket (optional - for remote state)
export TF_STATE_BUCKET=""

# Terraform state prefix
export TF_STATE_PREFIX="terraform/state"

# =============================================================================
# Cost Optimization Settings
# =============================================================================

# Enable cost optimization features (true/false)
export ENABLE_COST_OPTIMIZATION="true"

# Auto-shutdown Jenkins VM during off-hours (true/false)
export ENABLE_AUTO_SHUTDOWN="false"

# =============================================================================
# Labels and Tags
# =============================================================================

# Environment label
export ENVIRONMENT="development"

# Team label
export TEAM="devops"

# Application label
export APPLICATION="jenkins-cicd"
